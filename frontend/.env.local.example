# ─────────────────────────────────────────────────────────────────────────────
# Project Zenith — environment template. Copy to `.env.local` and fill in.
# ─────────────────────────────────────────────────────────────────────────────

# Cesium ion access token. Required for high-res imagery / terrain tiles.
# Get a free token at https://ion.cesium.com/tokens
# If omitted, CesiumGlobe falls back to the bundled offline natural-earth imagery.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Base URL of the future backend aggregation gateway. While empty, the app
# transparently uses the in-repo mock service layer (src/services/api/*).
NEXT_PUBLIC_API_BASE_URL=

# Set to "mock" (default) or "live". Controls services/api/client.ts routing.
NEXT_PUBLIC_DATA_SOURCE=mock
